msg[0] = "Noticed the gray smog below?";
msg[1] = "The smog in this space won't be harmful to human body, but will definitely interfere with the signal.";
msg[2] = "That means you will not be able to create a mark when you touch the smog. You cannot use 'Down' to teleport to the mark outside the smog either. You will be teleported only when the mark finishes its countdown."
msgLen = 3;