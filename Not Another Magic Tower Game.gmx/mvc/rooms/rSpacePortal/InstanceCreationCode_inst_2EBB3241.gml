msg[0] = "If you see this info, then you are already at an another dimension rather than your normal world."
msg[1] = "Time is another key dimension in this space. If you controlled well, it's possible you teleport to the place you were instantly.";
msg[2] = "Press 'Space Mark'(Default 'SPACE') to leave a mark, and if you are still alive in 3 secs, you will be teleported to the place you marked directly. Or you can just press 'Down' to teleport to the mark has least time left instantly."
msg[3] = "Your status will be remained after teleporting. Note that you cannot leave more than 3 marks at the same time.";
msg[4] = "If you want to travel more in this space, then learn to adapt to the rules here.";
msgLen = 5;