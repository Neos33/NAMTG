// 2025-06-19 19:07:16
#event properties (no comments/etc. here are saved)
parent_index = obj_tlSummonedParent;
sprite_index = spr_skeletonEleteWithoutSword1;
uses_physics = false;

#event create
image_speed = 1/8;
x = 400 + sign(x - player.x)*196;
y = 352;
image_xscale = sign(x - 400);
height = 0;
instance_create(x,y,obj_tlSkeletonSwordTrace);
event_inherited();


sword = false;

#event alarm3
obj_tlSkeletonSword.start = true;
if(image_xscale > 0)
{
    var wind = instance_create(x - 32, y - 32, obj_tlSkeletonWind);
    wind.hspeed = -5;
}
else
{
    var wind = instance_create(x + 32, y - 32, obj_tlSkeletonWind);
    wind.hspeed = 5;
}
audio_playsound(sndwind1);
alarm[4] = 50;

#event alarm4
with(obj_tlSkeletonSword)
{
    instance_destroy();
}
instance_destroy();

#event step
if(start)
{
    if(height < 32)
    {
        height += 32/80;
    }
    else if(!sword)
    {
        var s = instance_create(x - 10 * image_xscale, y+ 18, obj_tlSkeletonSword);   
        s.image_xscale = image_xscale;
        sword = true;
        alarm[3] = 10;
    }
}

#event draw
if(height>0)
{
    draw_sprite_part_ext(sprite_index,image_index,0,0,32,height,x-(16*image_xscale),y,image_xscale,image_yscale,c_white,1);   
}