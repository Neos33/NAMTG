// 2025-06-19 19:59:21
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
step = 1;
alpha = 1;
roomTo = 0;

#event alarm0
if(!player_is_alive()) exit;
room_goto(roomTo);

#event step

if(step < 32)
{
    step += 2;
}
if(!player_is_alive())
{
    if(alpha > 0)
    {
        alpha -= 0.05;
    }  
    else
    {
        instance_destroy();
    } 
}


#event draw
draw_set_alpha(alpha);
draw_set_color(c_black);
draw_rectangle(view_xview[0]+400-25*step/2,view_yview[0]+304-19*step/2,view_xview[0]+400+25*step/2,view_yview[0]+304+19*step/2,false);


draw_reset_color();