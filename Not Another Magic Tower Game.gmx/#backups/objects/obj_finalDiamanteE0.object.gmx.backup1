// 2025-06-19 20:54:23
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
image_speed=0;
n=1.753;
n0=n;
image_xscale=0.25;
image_yscale=0.25;


dir_x = 0;
dir_y = 0;
nn = 0;
t = 0;
dd = 0;

#event step
x = 400 + lengthdir_x(100,dir_x);
y = 150 + abs(lengthdir_y(50,dir_y));
dir_x+=n0;
dir_y+=n0;
n += nn;
nn += 0.005;
t+=1;
dd+=n;
if t mod 12 == 0{
    for(j=0;j<4;j+=1)
    for(i=0;i<3;i+=1){
        a=instance_create(x,y,obj_finalDiamanteF0);
        a.dd=90*j+point_direction(400,-100,x,y);//dd+t*2;
        a.image_index=ind;
        a.spd=3+2*i
        a.ind = j*3+i;
    }
}