// 2025-06-19 20:27:45
#event properties (no comments/etc. here are saved)
parent_index = obj_silverEvilSlime_combat;
sprite_index = spr_silverEvilSlime_combat;
uses_physics = false;

#event create
//event_inherited();
name = "Silver Evil Slime";
image_speed = 1/8;
x = 624;
y = 128;
image_xscale = 2.5;
image_yscale = 2.5;
hp = global.mHP;

spList = ds_list_create();
ds_list_add(spList, "Normal");
ds_list_add(spList, "Fire");
ds_list_add(spList, "Water");
ds_list_add(spList, "Grass");
ds_list_add(spList, "Rock");
ds_list_add(spList, "Electric");
ds_list_add(spList, "Ghost");
ds_list_add(spList, "Psychic");
ds_list_add(spList, "Unknown");

blendColor = c_white;
mixedAlpha = 1;


spIndex = irandom_range(1,7);
image_index = spIndex;
sp = ds_list_find_value(spList, spIndex);


event_user(0);


#event destroy
ds_list_destroy(spList);
event_inherited();

#event alarm3
instance_create(x, y - 48, obj_silverEvilSlimeQuestionMark);

#event alarm4
with(obj_pokemonBattleDialog)
{
    msg = "Wild " + other.name + " appears.";
    event_user(0);
}

#event alarm10
if(mixedAlpha > 0)
{
    mixedAlpha -= 0.02;
    alarm[10] = 1;
}
else
{
    sp = "Normal";
    instance_create(144, 256, obj_pokemonCombatPlatform);
}

#event alarm11
if(mixedAlpha < 1)
{
    mixedAlpha += 0.02;
    alarm[11] = 1;
}
else
{
    event_user(spIndex);
}

#event collision:bullet
with(other)
{
    hitEffect();
    instance_destroy();
}

#event other_room_end
sound_stop_all();

#event other_user0
sp = ds_list_find_value(spList, spIndex);
switch(sp)
{
    case "Fire" : blendColor = make_color_rgb(240,128,48); break;
    case "Water" : blendColor = make_color_rgb(104,144,240); break;
    case "Grass" : blendColor = make_color_rgb(120,200,80); break;
    case "Rock" : blendColor = make_color_rgb(184,160,56); break;
    case "Electric" : blendColor = make_color_rgb(248,208,48); break;
    case "Ghost" : blendColor = make_color_rgb(112,88,152); break;
    case "Psychic" : blendColor = make_color_rgb(248,88,136); break;
    default : blendColor = c_white;break;
}
alarm[11] = 1;

#event other_user1
instance_create(0,0,obj_silverEvilSlimeFireController);
with(obj_pokemonBattleDialog)
{
    msg = other.name + " uses Fire Storm.";
    event_user(0);
}

#event other_user2
instance_create(0,0,obj_silverEvilSlimeWaterController);
with(obj_pokemonBattleDialog)
{
    msg = other.name + " uses Water Bomb.";
    event_user(0);
}

#event other_user3
instance_create(0,0,obj_silverEvilSlimeLeafController);
with(obj_pokemonBattleDialog)
{
    msg = other.name + " uses Leaf Cut.";
    event_user(0);
}

#event other_user4
instance_create(0,0,obj_silverEvilSlimeRockController);
with(obj_pokemonBattleDialog)
{
    msg = other.name + " uses Rockfall.";
    event_user(0);
}

#event other_user5
instance_create(0,0,obj_silverEvilSlimeElectricController);
with(obj_pokemonBattleDialog)
{
    msg = other.name + " uses Thunderbolt.";
    event_user(0);
}

#event other_user6
instance_create(0,0,obj_silverEvilSlimeGhostController);
with(obj_pokemonBattleDialog)
{
    msg = other.name + " uses Ghost Fire.";
    event_user(0);
}

#event other_user7
instance_create(0,0,obj_silverEvilSlimePhychcController);
with(obj_pokemonBattleDialog)
{
    msg = other.name + " uses Meditation.";
    event_user(0);
}

#event other_user15
if(obj_pokemonKidInfo.hpPer <= 0.25)
{
    if(!global.achievements[69])
    {
        var ch = instance_create(0,608,obj_achievements);
        ch.index = 69;
        global.achievements[69] = 1;
    }
}

#event draw
draw_sprite_ext(sprite_index,image_index,x,y,image_xscale,image_yscale,image_angle,c_white,(1-mixedAlpha) * image_alpha);
draw_sprite_ext(sprite_index,image_index,x,y,image_xscale,image_yscale,image_angle,blendColor,mixedAlpha * image_alpha);