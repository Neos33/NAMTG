// 2025-06-19 21:19:55
#event properties (no comments/etc. here are saved)
parent_index = -1;
sprite_index = spr_darkWarrior_bomb_fire_1;
uses_physics = false;

#event create
image_xscale = 1;//0.1;
image_yscale = 1;//0.1;
image_speed = 0;
alarm[0] = 1;

sprInd = 0;
spr[0] = spr_darkWarrior_bomb_fire_1;
spr[1] = spr_darkWarrior_bomb_fire_2;
spr[2] = spr_darkWarrior_bomb_fire_3;
sprCount = 3;


start = false;
h = noone;
v = noone;
p = noone;

leftP = 0;
rightP = 0;
upP = 0;
downP = 0;



#event alarm0
if(sprInd < sprCount)
{
    //image_xscale += 0.05;
    //image_yscale += 0.05;
    sprite_index = spr[sprInd];
    sprInd += 1;
    alarm[0] = 5;
}
else
{
    start = true;
    sound_fix(sndFire1);
    h = instance_create(x-16-leftP * 32, y-16, obj_tlDWBombDmg);
    h.image_xscale = leftP + rightP + 1;
    v = instance_create(x-16, y-16-upP * 32, obj_tlDWBombDmg);
    v.image_yscale = upP + downP + 1;
    alarm[1] = 30;
    alarm[2] = 30;
}

#event alarm1
if(sprInd > 0)
{
    sprInd -= 1;
    sprite_index = spr[sprInd];    
    alarm[1] = 5;
}
else
{
    instance_destroy();
}

#event alarm2
start = false;
with(h)
{
    instance_destroy();
}
with(v)
{
    instance_destroy();
}

#event other_user0
left = x - p * 32 - 16;
right = x + p * 32 + 16;
up = y - p * 32 - 16;
down = y + p * 32 + 16;

leftP = p;
rightP = p;
upP = p;
downP = p;

#event draw
draw_set_blend_mode(bm_add);
draw_current();
//if(!start) exit;
for(i = 1; i <= leftP; i += 1)
{
    if(i < p)
    {
        draw_sprite(sprite_index, 5, x-32*i,y);
    }
    else
    {
        draw_sprite(sprite_index,4, x-32*i,y);
    }
}

for(i = 1; i <= rightP; i += 1)
{
    if(i < p)
    {
        draw_sprite(sprite_index, 5, x+32*i,y);
    }
    else
    {
        draw_sprite(sprite_index,6, x+32*i,y);
    }
}

for(i = 1; i <= upP; i += 1)
{
    if(i < p)
    {
        draw_sprite(sprite_index, 2, x,y-32*i);
    }
    else
    {
        draw_sprite(sprite_index,1, x,y-32*i);
    }
}

for(i = 1; i <= downP; i += 1)
{
    if(i < p)
    {
        draw_sprite(sprite_index, 2, x,y+32*i);
    }
    else
    {
        draw_sprite(sprite_index,3, x,y+32*i);
    }
}
draw_set_blend_mode(bm_normal);