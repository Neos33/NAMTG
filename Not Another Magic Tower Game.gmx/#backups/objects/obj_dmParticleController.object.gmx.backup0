fire2 = part_type_create();
part_type_shape(fire2,pt_shape_line);
part_type_size(fire2,0.20,0.60,0,0);
part_type_scale(fire2,0.65,2.50);
part_type_color3(fire2,16749459,16711808,8388736);
part_type_alpha3(fire2,0.2,0.3,0.35);
part_type_speed(fire2,0.70,1,-0.02,0);
part_type_direction(fire2,85,95,0,9);
part_type_gravity(fire2,0,270);
part_type_orientation(fire2,0,0,10,20,1);
part_type_blend(fire2,1);
part_type_life(fire2,10,15);




beam = part_type_create();
part_type_blend(beam,1);
part_type_color1(beam,make_color_rgb(195,31,255));
part_type_sprite(beam,sprBeam,0,0,0);
