// 2025-06-19 20:56:33
#event properties (no comments/etc. here are saved)
parent_index = obj_finalFadeBullet;
sprite_index = spr_finalFadeBullet;
uses_physics = false;

#event create

event_inherited();
image_speed=0;
image_alpha=0;
image_xscale=3;
image_yscale=3;

alarm[3] = 1;

child = noone;
spd = 0;
dd = 0;

#event destroy
with(child)
{
    instance_destroy();
}

#event alarm3
child = instance_create(x,y,obj_finalDarkSummoner);
child.parent = id;

#event step
if image_alpha<1
{
    image_alpha+=0.1;
    image_xscale-=0.25;
    image_yscale-=0.25;
}
else
{
    var a=instance_create(x,y,obj_finalDiamanteB0);
    a.depth=1;
    a.image_index=image_index;
    a.speed=spd;
    a.direction=dd;
    instance_destroy()
}

#event draw
draw_sprite_ext(sprite_index,image_index,x,y,image_xscale,image_yscale,image_angle,image_blend,image_alpha);