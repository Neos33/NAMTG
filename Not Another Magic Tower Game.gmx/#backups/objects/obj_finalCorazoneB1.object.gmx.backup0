#event properties (no comments/etc. here are saved)
parent_index = obj_finalTouhouKiller;
sprite_index = spr_finalLaser;
uses_physics = false;

#event create
//
event_inherited();
dirspd = 0;

#event alarm0
var a=instance_create(x,y,obj_finalFadeBullet);
a.image_blend=image_blend;
instance_destroy();

#event other_outside
//

#event draw
direction += dirspd;
draw_set_blend_mode(bm_add);
draw_sprite_ext(sprite_index,image_index,x,y,image_xscale,image_yscale,direction,image_blend,image_alpha);
draw_set_blend_mode(bm_normal);