// 2025-06-19 19:17:03
#event properties (no comments/etc. here are saved)
parent_index = obj_tlSummonedParent;
sprite_index = spr_steel_combat;
uses_physics = false;

#event create
image_xscale = 2;
image_yscale = 2;
alarm[3] = 20;
event_inherited();

start = false;

#event alarm3
start = true;
vspeed = 20;

#event alarm4
instance_destroy();

#event collision:block
if(start)
{
    start = false;
    vspeed = 0;
    y = other.y - 16*image_yscale;
    sound_fix(sndEarth1);
    instance_create(x,y,view_shaker1);
    for(var i=0;i<8;i+=1)
    {
        var aa = instance_create(x,y,obj_tlSteelBomb);
        aa.speed = 5;
        aa.direction = i*45;
    }
    alarm[4] = 20;
}