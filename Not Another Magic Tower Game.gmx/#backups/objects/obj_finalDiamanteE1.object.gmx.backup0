// 2025-06-19 20:59:13
#event properties (no comments/etc. here are saved)
parent_index = -1;
sprite_index = spr_diaSpike;
uses_physics = false;

#event create
lenspd = 2;
dirspd = 1;
alarm[0] = 140;
image_speed=0;
alarm[1] = 3;
aaa=30;


dir = 0;
len = 0;

#event alarm0
lenspd = 0;
alarm[2] = 1;
alarm[3] = 50;
alarm[4] = 100;

#event alarm1
for(var i=0;i<1;i+=1)
{
    var a=instance_create(x,y,obj_finalDiamanteB1);
    a.image_index=image_index;
    a.image_angle=image_angle;
    a.image_speed=0;
    a.speed=5;
    a.direction=point_direction(400,304,x,y)+60-i*20;
    alarm[1]=3;
}

#event alarm2
if(dirspd<2)
{
    dirspd += 0.02;
    alarm[2] = 1;
}


#event alarm3
for(var i=6;i<30;i+=1)
{
    for(var j=0;j<4;j+=1)
    {
        var rr = (i-5)*11;
        var xx = x+lengthdir_x(rr,j*45+image_angle);
        var yy = y+lengthdir_y(rr,j*45+image_angle);
        var a=instance_create(xx,yy,obj_finalDiamanteB1);
        a.image_speed=image_speed;
        a.image_index=image_index;
        a.alarm[0]=2*(i);
        a.image_alpha=0;
        a.par=id;
        a.len=rr;
        a.dir=j*45+image_angle-25;
        a.dirspd=2;
        a.st1=1;
        a.image_xscale=(46-i)/46;
        a.image_yscale=a.image_xscale*3;
    }
}


#event alarm4
with(obj_finalDiamanteB1){
    if(st1){
        dirspd = 2.1;
    }
}

#event alarm5
for(var i=-1;i<=1;i+=2)
{
    var a=instance_create(x,y,obj_finalDiamanteB1);
    a.image_index=image_index;
    a.image_angle=image_angle;
    a.image_speed=0;
    a.speed=5;
    a.direction=point_direction(400,304,x,y)+180-i*aaa;
}
alarm[5]=3;

#event alarm6
aaa-=0.067;
alarm[6]=1;

#event step
image_angle = dir + 90;
x = 400 + lengthdir_x(len,dir);
y = 304 + lengthdir_y(len,dir);
len += lenspd;
dir += dirspd;

#event draw
draw_set_blend_mode(bm_add);
draw_sprite_ext(sprite_index,image_index,x,y,image_xscale,image_yscale,image_angle,image_blend,image_alpha);
draw_set_blend_mode(bm_normal);