// 2025-06-19 21:26:52
#event properties (no comments/etc. here are saved)
parent_index = -1;
sprite_index = spr_tlFinalMagicCircle;
uses_physics = false;

#event create
dir1 = random(360);
scale = 0.01;
image_xscale = scale;
image_yscale = scale;


timer = 0;

#event step
image_angle += 5;
if timer < 500{
    if(timer mod 3 == 0){
        event_user(0);
    }
}
else if(timer < 1000){
    if(timer mod 50 == 0){
        event_user(1);
    }
    if(timer mod 50 == 25){
        event_user(2);
    }
}
else{
    if(timer mod 50 == 0){
        event_user(1);
    }
    if(timer mod 50 == 25){
        event_user(2);
    }
    var tempTimer = 6-floor((timer-2000)/250);
    if(tempTimer > 0)
    {
        if(timer mod tempTimer == 0){
            event_user(3);
        }
    }
    else
    {
        event_user(3);
    }
}
if timer == 250{
    event_user(4);
}
timer+=1;
#section
if(scale < 1)
{
    scale += 0.02;
    image_xscale = scale;
    image_yscale = scale;
}

#event other_user0
var a=instance_create(x,y,obj_finalBossBullet);
a.speed=10;
a.friction=0.4;
a.image_xscale=0.5;
a.image_yscale=0.5;
a.direction=point_direction(x,y,obj_finalPlane.x,obj_finalPlane.y)+random_range(-80,80);
a.alarm[0]=1;
a.dirspd=random_range(-2,2)

#event other_user1
for(var i=0;i<36;i+=1)
{
    var xx = x + lengthdir_x(128,360/36*i+dir1);
    var yy = y + lengthdir_y(128,360/36*i+dir1);
    var a = instance_create(xx,yy,obj_finalBossBullet);
    a.speed = 2 + abs((i mod 9)-4);
    a.direction = point_direction(a.x,a.y,x,y)+60;
    a.image_xscale = 0;
    a.image_yscale = 0;
    a.alarm[1] = 1;
}
dir1 += 4.3;

#event other_user2
for(var i=0;i<36;i+=1)
{
    var xx = x + lengthdir_x(128,360/36*i+dir1);
    var yy = y + lengthdir_y(128,360/36*i+dir1);
    var a = instance_create(xx,yy,obj_finalBossBullet);
    a.speed = 2 + abs((i mod 9)-4);
    a.direction = point_direction(a.x,a.y,x,y)-60;
    a.image_xscale = 0;
    a.image_yscale = 0;
    a.alarm[1] = 1;
}
dir1 += 4.3;

#event other_user3
var a=instance_create(x,y,obj_finalBossBullet);
a.speed=10;
a.friction=0.4;
a.image_xscale=0.5;
a.image_yscale=0.5;
a.direction=point_direction(x,y,obj_finalPlane.x,obj_finalPlane.y)+random_range(-80,80);
a.alarm[2]=1;
a.dirspd=random_range(-2,2)

#event other_user4
var ang = random(360);
var rnd = choose(0,1);
for(var i=0;i<4;i+=1)
{
    var a=instance_create(x,y,obj_finalBossBullet);
    a.speed=4;
    a.direction=ang+i*90;
    a.bounce=1;
    a.sprite_index=spr_finalTrebole16;
    a.image_single=rnd+2*i;
    for(var j=0;j<4;j+=1)
    {
        var b=instance_create(x,y,obj_finalBossBullet2);
        b.parent=a;
        b.active=1;
        b.image_index=a.image_index;
        b.lenspd=0.5;
        b.dir=j*90;
        b.dirspd=3;
        b.alarm[0]=100;
    }
}

#event draw
draw_set_blend_mode(bm_add);
draw_current();
draw_set_blend_mode(bm_normal);