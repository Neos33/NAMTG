// 2025-06-19 20:03:34
#event properties (no comments/etc. here are saved)
parent_index = -1;
sprite_index = spr_draculaClaw;
uses_physics = false;

#event create
image_xscale = obj_tl_draculaRealBody.targetScale;
image_yscale = obj_tl_draculaRealBody.targetScale;
image_speed = 0;
isStable = true;
alarm[3] = 1;


targetX1 = 0;
targetX2 = 0;
targetY = 0;
xStep = 0;
dash = false;

#event alarm3
if(abs(y - targetY) > 2)
{
    move_towards_point(x,targetY,2);
    alarm[3] = 1;
}
else
{
    hspeed = 0;
    vspeed = 0;
    image_index = 1;
    alarm[4] = 1;
}

#event alarm4
if(abs(x - targetX1) > 2)
{
    xStep = 2 * sign(targetX1 - x);
    x += xStep;
    alarm[4] = 1;
}
else
{
    x = targetX1;
    dash = true;
    image_index = 2;
    audio_playsound(sndSkill15);
    alarm[5] = 1;
}

#event alarm5
if(abs(x - targetX2) > 15)
{
    xStep = 15 * sign(targetX2 - x);
    x += xStep;
    alarm[5] = 1;
}
else
{
    x = targetX2;
    dash = false;
    obj_tl_draculaRealBody.tranAlpha = 1;
    obj_tl_draculaRealBody.alarm[1] = 1;
}

#event collision:player
if(image_alpha > 0.8 && !dash)
{
    event_inherited();
}
if(dash && !obj_tl_draculaRealBody.clawHit)
{
    obj_tl_draculaRealBody.clawHit = true;
    global.monsterSuperCritical = true;
    if(player.vspeed > -3)
    {
        player.vspeed = -3;
    }
}

#event draw
if(dash)
{
    draw_sprite_ext(sprite_index, image_index, x - xStep * 3,y,image_xscale,image_yscale,image_angle,c_purple,0.4);
    draw_sprite_ext(sprite_index, image_index, x - xStep * 2,y,image_xscale,image_yscale,image_angle,c_purple,0.6);
    draw_sprite_ext(sprite_index, image_index, x - xStep,y,image_xscale,image_yscale,image_angle,c_purple,0.8);
}
draw_current();