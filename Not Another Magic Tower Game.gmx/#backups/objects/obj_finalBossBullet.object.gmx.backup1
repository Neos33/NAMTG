// 2025-06-19 22:03:48
#event properties (no comments/etc. here are saved)
parent_index = obj_finalTouhouKiller;
sprite_index = sprite0_spr_danmaku12_gray;
uses_physics = false;

#event create
//
event_inherited();
active = false;
t0 = 0;
dirspd = 0;

#event alarm0
if(speed <= friction){
    friction = -0.1;
    active = 1;
}
if(active){
    t0 += 1;
    if t0 > 20 && t0 < 45{
        direction += dirspd;
    }
    else{
        alarm[0] = 0;
    }
}
alarm[0] = 1;

#event alarm1
if(image_xscale < 0.5){
    image_xscale += 0.05;
    image_yscale = image_xscale;
}
alarm[1] = 1;

#event alarm2
if(speed <= friction){
    friction = -0.05;
    active = 1;
}
if(active){
    t0 += 1;
    if t0 > 10 && t0 < 30{
        direction += dirspd;
    }
    else{
        alarm[2] = 0;
    }
}
alarm[2] = 1;

#event step
if(bounce){
    if(x + hspeed + 50 > room_width || x + hspeed - 50 < 0){
        hspeed = -hspeed;
    }
    if(y + vspeed + 50 > room_height || y + vspeed - 50 < 0){
        vspeed = -vspeed;
    }
}

#event other_outside
#action action_kill_object

#event draw
draw_set_blend_mode(bm_add);
draw_current();
draw_set_blend_mode(bm_normal);