// 2025-06-19 19:16:20
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
alarm[1]=1;
alarm[0]=5;

hspd = 0;

#event alarm0
var cn=instance_create(x,y,obj_tlStoneRock)
cn.vspeed=-3;
cn.image_xscale = 0.6;
cn.image_yscale = 0.6;
cn.image_speed = 1/8;
cn.gravity=0.18;
alarm[0]=3;

#event alarm1
hspeed=hspd;

#event step
if(x <= 192 || x >= 608)
{
    instance_destroy();
}