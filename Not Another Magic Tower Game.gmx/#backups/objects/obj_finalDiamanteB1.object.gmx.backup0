// 2025-06-19 20:57:55
#event properties (no comments/etc. here are saved)
parent_index = obj_finalTouhouKiller;
sprite_index = spr_finalDiamante32;
uses_physics = false;

#event create
event_inherited();
image_speed = 0;


st1 = false;
par = noone;
len = 0;
dirspd = 0;
dir = 0;

#event alarm0
if image_alpha<1 {image_alpha+=0.05;alarm[0]=1;}

#event other_outside
#action action_kill_object

#event draw
if(st1){
    x = par.x + lengthdir_x(len,dir);
    y = par.y + lengthdir_y(len,dir);
    dir += dirspd;
    image_angle = dir+90;
}
else{
    image_angle = direction+90;
}
draw_set_blend_mode(bm_add);
draw_sprite_ext(sprite_index,image_index,x,y,image_xscale,image_yscale,image_angle,image_blend,image_alpha);
draw_set_blend_mode(bm_normal);