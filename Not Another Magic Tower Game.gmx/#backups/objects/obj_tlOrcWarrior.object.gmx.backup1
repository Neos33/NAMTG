// 2025-06-19 19:22:16
#event properties (no comments/etc. here are saved)
parent_index = obj_tlSummonedParent;
sprite_index = spr_orcWarrior_combat;
uses_physics = false;

#event create
alarm[3] = 30;
alarm[4] = 30;
event_inherited();

i = 0;

#event alarm3
aa=instance_create(x,y,obj_cherry_black)
with(aa)
{
    speed=random_range(4,6);
    direction= 90 + sign(x-400) * random_range(15,90);
    gravity=0.1;
}
if(i<15)
{
    i+=1;
    alarm[3]=6;
}
else
{
    instance_destroy();
}

#event alarm4
sound_fix(sndwarrior)