// 2025-06-19 20:31:13
#event properties (no comments/etc. here are saved)
parent_index = -1;
sprite_index = spr_bsFireShot;
uses_physics = false;

#event create
image_alpha = 0;
image_speed = 1/4;
alarm[0] = 100;
alarm[1] = 35;
event_inherited();


disappear = false;
lead = false;

#event alarm0
disappear = true;
if(image_alpha > 0)
{
    image_alpha -= 0.02;
    alarm[0] = 1;
}
else
{
    instance_destroy();
}

#event alarm1
if(lead)
    instance_create(x-16,y-24-64,obj_tlOriginalPlatform);

#event step
if(disappear) exit;
if(image_alpha < 1)
{
    image_alpha += 0.05;
}

#event draw
draw_set_blend_mode(bm_add);
draw_current();
draw_set_blend_mode(bm_normal);