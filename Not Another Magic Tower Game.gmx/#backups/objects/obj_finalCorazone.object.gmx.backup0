// 2025-06-19 20:49:11
#event properties (no comments/etc. here are saved)
parent_index = obj_finalTouhouDevas;
sprite_index = spr_diamante_combat_1;
uses_physics = false;

#event create
event_inherited();

//the ability of summoning lasers
image_alpha=0;
//parameter start
maxnum=15;
yfac=10;
xmin=1.0;
xmax=1.2;
n0=20;
flag=1;
ttime=50;
//parameter end
c_start=c_yellow;
c_middle=merge_color(c_white,c_start,0.8);
alarm[0]=1;
alarm[1]=ttime;
alarm[2]=1;
alarm[3]=50;
event_inherited();
image_speed = 1/8;
circle = instance_create(x,y,obj_tlMagicCircle);
circle.target = id;
image_xscale = 0.8;
image_yscale = 0.8;


percent = 0;
dir = 0;
n = 0;
angle = 0;


#event destroy
with(circle)
{
    instance_destroy();
}

#event alarm0
percent = sin(n*pi/maxnum);
if n == 0
{
    dir = random(360);
}
event_user(0);
n+=1;
if n<=maxnum
{
    alarm[0]=1;
}
else{
    alarm[0]=0;
}

#event alarm1
n = 0;
flag *= -1;
if(c_start == c_yellow)
{
    c_start = c_green;
}
else{
    c_start = c_yellow;
}
alarm[0] = 1;
alarm[1] = ttime;


#event alarm2
image_alpha += 0.02;
alarm[2] = 1;

#event alarm3
angle=point_direction(x,y,obj_playerTouhou.x,obj_playerTouhou.y);
for(var i=0;i<12;i+=1)
{
    var a=instance_create(x,y,obj_finalTreboleB3);
    a.sprite_index=spr_finalTreboleGray;
    a.speed=4;
    a.direction=angle+30*i;
}
alarm[3]=100;

#event other_user0
for(var i=1;i<=n0;i+=1)
{
    var dd = 360/n0*i+dir;
    var xx = 400 + lengthdir_x(350,dd);
    var yy = 304 + lengthdir_y(350,dd);
    var a=instance_create(xx,yy,obj_finalCorazoneB1);
    a.speed=4.5; 
    a.direction=(dd+90)+(flag==-1)*180;
    a.dirspd=flag*360*4.5/pi/350;
    a.alarm[0]=180/abs(a.dirspd);
    a.image_xscale=xmin+(xmax-xmin)*percent;
    a.image_yscale=a.image_xscale/yfac;
    a.image_blend=merge_color(c_start,c_middle,percent);
    dir+=18;
}


#event draw
draw_set_blend_mode(bm_add);
draw_current();
draw_set_blend_mode(bm_normal);