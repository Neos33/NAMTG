// 2025-06-19 20:18:23
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
alarm[0] = 1;
count = 8;


tailCount = 0;

#event alarm0
if(count > 0)
{   
    var rotate = instance_create(obj_tl_burningKnight.x, obj_tl_burningKnight.y - 32, obj_tl_bkRotateElement);
    
    var rotateDir;
    if((count mod 2) == 0)
    {
        rotateDir = 1;
    }
    else
    {
        rotateDir = -1;
    }
    rotate.angle = 90;
    rotate.rDir = rotateDir;
    tailCount = 8;
    for(var i = 0; i < tailCount; i+=1)
    {
        var tAngle = 90 - rotateDir * (i + 1 * 2);
        var tail = instance_create(obj_tl_burningKnight.x + (31 - i) * cos(degtorad(tAngle)), obj_tl_burningKnight.y - (31 - i) * sin(degtorad(tAngle)), obj_tl_bkRotateTail);
        var tailScale = 0.22 - i * 0.02;
        tail.image_xscale = tailScale;
        tail.image_yscale = tailScale;
        tail.image_alpha = 1 - i / 9;
        tail.angle = tAngle;
        tail.rDir = rotateDir;
        tail.r = 30 - i * 2;
    }
    //alarm[1] = 1;
    count -= 1;
    alarm[0] = 15 + 15 * obj_tl_burningKnight.hp / obj_tl_burningKnight.oHP;
}
else
{
    alarm[2] = 1;
}

#event alarm1
/*if(tailCount > 0)
{
    tail = instance_create(obj_burningKnight_combat.x, obj_burningKnight_combat.y - 32, obj_bkRotateTail);
    tailScale = 0.16 + tailCount * 0.01;
    tail.image_xscale = tailScale;
    tail.image_yscale = tailScale;
    tail.image_alpha = tailCount / 9;
    tail.angle = 90;
    tail.rDir = rotateDir;
    tailCount -= 1;
    alarm[1] = 1;
}

#event alarm2
obj_tl_burningKnight.alarm[10] = 1 + (30 * obj_tl_burningKnight.hp / obj_tl_burningKnight.oHP);
instance_destroy();