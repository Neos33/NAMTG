// 2025-06-19 22:09:42
#event properties (no comments/etc. here are saved)
parent_index = -1;
sprite_index = spr_tlFlashBack;
uses_physics = false;

#event create
image_speed = 0;
image_alpha = 0;
image_xscale = 2;
image_yscale = 2;
alarm[0] = 1;

alpha = 0;
red = 0;

#event alarm0
if(image_alpha < 0.8)
{
    image_alpha += 0.1;
    alarm[0] = 1;
}
else
{
    alarm[1] = 15;
}

#event alarm1
if(alpha < 1)
{
    alpha += 0.1;
    alarm[1] = 1;
}
else
{
    alarm[2] = 1;
    image_alpha = 0;
    red = 0;
}

#event alarm2
if(alpha > 0)
{
    //red += 1;
    //image_blend = make_color_rgb(red,0,0);
    alpha -= 0.01;
    alarm[2] = 1;
}
else
{
    instance_destroy();
}

#event draw
draw_current();
draw_sprite_ext(sprite_index,image_index + 1, x,y,image_xscale,image_yscale,image_angle,image_blend, alpha);