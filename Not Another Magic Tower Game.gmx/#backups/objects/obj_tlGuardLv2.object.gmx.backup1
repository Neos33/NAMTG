// 2025-06-19 19:10:26
#event properties (no comments/etc. here are saved)
parent_index = obj_tlSummonedParent;
sprite_index = spr_guardlv2Combat;
uses_physics = false;

#event create
alarm[10] = 10;
event_inherited();


sound = false;
smash = false;

wind = false;
windTime = 0;
windDelay = 0;

rspd = 0;
rdir = 0;

blast = 0;
blastX = 0;

#event alarm3
vspeed = -10;
gravity = 0.25;
alarm[4] = 40;

#event alarm4
gravity = 0;
direction = point_direction(x,y,player.x,player.y);
speed = 15;
image_angle = sign(x - player.x) * 45;
if(sound)
    sound_fix(sndZhazha);
smash = true;

#event alarm5
instance_destroy();

#event alarm10
image_angle = 0;
rspd = 0;
rdir = 1;
if(sound)
    sound_fix(sndExpMax);
sprite_index = spr_guardlv2SwordBlast;
wind = true;
windTime = 100;
windDelay = 10;

#event step
if(wind)
{
    if(windDelay > 0)
    {
        windDelay -= 1;
        if(windDelay == 0)
        {
            blast = instance_create(x,y, obj_tlGuardlv2blast);
            blast.parent = instance_position(x,y,obj_tlGuardLv2);
        }
    }
    else
    {
        if(rdir == 1)
        {
            if(image_xscale > -1)
            {
                image_xscale -= rspd;
            }
            else
            {
                rdir = 2;
                if(sound)
                    sound_fix(sndSwing1);
            }
        }
        else if(rdir == 2)
        {
            if(image_xscale < 1)
            {
                image_xscale += rspd;
            }
            else
            {
                rdir = 1;
            }
        }
        if(rspd < 1 && windTime > 0)
        {
            rspd += 0.02;
        }
        hspeed += sign(blastX - x)*0.2;
        if(image_xscale > 1)
        {
            image_xscale = 1;
        }
        if(image_xscale < -1)
        {
            image_xscale = -1;
        }
        image_alpha = abs(image_xscale) / 2 + 0.5;
        if(windTime > 0)
        {
            windTime -= 1;
        }
        else
        {
            if(rspd > 0)
            {
                rspd -= 0.02;
            }
            else
            {
                image_xscale = 1;
                image_alpha = 1;
                sprite_index = spr_guardlv2Combat;
                hspeed = 0;
                blast.alarm[10] = 1;
                wind = false;
                alarm[3] = 5;
            }
        }
    }
}

#event collision:block
if(smash)
{
    speed = 0;
    x += lengthdir_x(15,direction);
    y += lengthdir_y(15,direction);
    
    var px, py;
    
    if(other.x < 0)
    {
        px = 0;
        py = y;
    }
    else if(other.x >= 800)
    {
        var px = 800;
        py = y;   
    }
    else
    {
        px = x;
        py = other.y;
    }
    instance_create(px,py,obj_guardlv2explode);
    smash = false;
    if(sound)
    {
        sound_fix(sndEarth1);
    }
    alarm[5] = 5;
}

#event other_outside
instance_destroy();