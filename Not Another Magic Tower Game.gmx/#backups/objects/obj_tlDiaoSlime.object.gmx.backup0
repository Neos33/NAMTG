// 2025-06-20 10:59:41
#event properties (no comments/etc. here are saved)
parent_index = obj_tlSummonedParent;
sprite_index = spr_diaoSlime_combat;
uses_physics = false;

#event create
event_inherited();
alarm[3] = 35;
alarm[4] = 65;
baseY = y + 16;
targetX = 800 - x + 16 * sign(x - 400);
targetY = y - 23;

alarm[7] = 1;


ind = 0;
diao = false;

#event alarm3
if(ind == 1)
{
    sound_fix(sndExpMax);
}
sprite_index = spr_lvupFlash;
image_speed = 1/4;
image_xscale = 4*ind;
image_yscale = 4;

#event alarm4
diao = true;
image_xscale = ind;
image_yscale = 1;
image_speed = 1/8;
y += 16 + 39;
sprite_index = spr_tlDiao;
alarm[5] = 1;

#event alarm5
if(y > targetY)
{
    y -= 3;
    alarm[5] = 1;
}
else
{
    y = targetY;
    alarm[6] = 1;
}

#event alarm6
if(abs(x-targetX) > 3)
{
    var dir = sign(x - targetX);
    x -= 3*dir;
    alarm[6] = 1;
}
else
{
    sprite_index = spr_diaoSlime_combat;
    y = baseY - 16;
    image_xscale = 1;
    image_yscale = 1;
    instance_destroy();
}

#event alarm7
if(ind == -1)
{
    instance_create(400,400,obj_tlVariationSkeleton);
}

#event alarm11
instance_create(400,192, obj_tlGuardLv3);

#event draw
if(!diao)
{
    draw_current();
}
else
{
    var height = baseY - (y-39);
    if(height > 0)
    {
        draw_sprite_part_ext(sprite_index,image_index,0,0,90,height,x-45*ind,y-39,image_xscale,image_yscale,image_blend,image_alpha);
    }
}