// 2025-06-19 21:07:33
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
alpha = 0.5;
alarm[0] = 1;
txt = "";

#event alarm0
if(alpha < 1)
{
    alpha += 0.01;
    alarm[0] = 1;
}
else
{
    alarm[1] = 1;
}

#event alarm1
if(alpha > 0.5)
{
    alpha -= 0.01;
    alarm[1] = 1;
}
else
{
    alarm[2] = 1;
}

#event alarm2
if(alpha < 1)
{
    alpha += 0.01;
    alarm[2] = 1;
}
else
{
    alarm[3] = 1;
}

#event alarm3
if(alpha > 0)
{
    alpha -= 0.01;
    alarm[3] = 1;
}
else
{
    instance_destroy();
}

#event step
if(instance_exists(obj_playerTouhou))
{
    x = obj_playerTouhou.x;
    y = obj_playerTouhou.y - 24;
}

if(instance_exists(obj_finalPlane))
{
    x = obj_finalPlane.x;
    y = obj_finalPlane.y - 24;
}

#event draw
draw_set_color(c_silver);
draw_set_alpha(alpha);
draw_set_font(fontBasicInfoMini);
draw_set_halign(fa_center);
draw_set_valign(fa_middle);
draw_text(x,y,txt);


draw_reset();