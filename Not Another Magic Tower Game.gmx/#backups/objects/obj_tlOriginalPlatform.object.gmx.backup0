// 2025-06-19 20:31:24
#event properties (no comments/etc. here are saved)
parent_index = movingPlatform;
sprite_index = spr_tlFirePlatform;
uses_physics = false;

#event create
image_alpha = 0;
image_speed = 1/15;
alarm[0] = 130;
event_inherited();

disappear = false;

#event alarm0
disappear = true;
if(image_alpha > 0)
{
    image_alpha -= 0.02;
    alarm[0] = 1;
}
else
{
    instance_destroy();
}

#event step
if(disappear) exit;
if(image_alpha < 1)
{
    image_alpha += 0.05;
}