// 2025-06-19 20:08:29
#event properties (no comments/etc. here are saved)
parent_index = obj_combatPlayerKiller;
sprite_index = spr_swordMaster_combat;
uses_physics = false;

#event create
#action action_inherited
#section
name = "Sword Master";
image_speed = 1/8;
x = 608;
y = 368;
alarm[3] = 20;



sx = 0;
sy = 0;
tx = 0;
ty = 0;

ind = 0;

bounce = false;
bounceCount = 0;
countdown = 0;
evtInd = 0;

#event alarm3
if(player_is_alive())
{
    instance_create(x + sign(player.x - x) + 16, y, obj_tl_swordMasterThrowingSword);
    sx = x;
    sy = y;
}

#event alarm4
event_user(5);

#event alarm5
tx = player.x - 64 * sign(400 - player.x);
ty = player.y - 64;
x = tx;
y = ty;
ind = 6;
event_user(1);


#event alarm6
ind = 7;
event_user(3);
if(!bounce)
{
    bounce = true;
    bounceCount = 3;
}

#event alarm7
if(point_distance(x,y, tx, ty) > spd)
{
    move_towards_point(tx,ty,spd);
    alarm[7] = 1;
}
else
{
    hspeed = 0;
    vspeed = 0;
    x = tx; 
    y = ty;
    alarm[10] = 1;
}

#event alarm10
p = path_add();
path_set_kind(p,1);
path_set_precision(p,4);
var len = RangeClamp(player.x + random_range(-96, 96), 160, 640) - x;
path_set_closed(p, false);
path_add_point(p, x,y,100);
path_add_point(p, x + len / 2,y - 32,100);
path_add_point(p, x + len,y ,100);

path_start(p, 12, 0, true);


#event step
if(status == 1)
{
    if(point_distance(x,y,400,80) < 15)
    {
        hspeed = 0;
        vspeed = 0;
        x = 400;
        y = 80;
        status = 0;
        instance_create(x,y, obj_swordMasterThrower);
        sound_fix(sndBurst1);
    }
}
else if(status == 2)
{
    if(point_distance(x,y,tx, ty) < 15)
    {
        hspeed = 0;
        vspeed = 0;
        x = tx;
        y = ty;
        alarm[3] = 70;
        status = 0;
    }
}
else if(status == 3)
{
    if(countdown > 0)
    {
        countdown -= 1;
    }
    else
    {
        status = 0;
        event_user(evtInd);
    }
}

#event collision:bullet
with(other)
{
    hitEffect();
    instance_destroy();
}

#event other_end_of_path
if(bounceCount > 0)
{
    bounceCount -= 1;
    alarm[10] = 1;
}
else
{
    evtInd = 4;
    countdown = 15;
    status = 3;
}

#event other_user0
var ds = instance_create(x,y,obj_swordMasterDashStart);
ds.tx = x;
ds.ty = y;
ds.dir = point_direction(sx,sy,tx,ty);;
x = -32; 
y = -32;


#event other_user1
var de = instance_create(x,y,obj_tl_sworkMasterDashEnd);
de.tx = tx;
de.ty = ty;
de.dir = point_direction(tx,ty,sx,sy);
de.ind = ind;
x = tx; 
y = ty;

#event other_user2
instance_create(x,y,obj_swordMasterDashEffect);

#event other_user4
hit = instance_create(x + 10 * sign(x - player.x), y - 8, obj_tl_swordMasterHit1);
hit.ind = ind;

#event other_user5
var dashHit = instance_create(x,y,obj_tl_swordMasterDashHit);
dashHit.ind = ind;