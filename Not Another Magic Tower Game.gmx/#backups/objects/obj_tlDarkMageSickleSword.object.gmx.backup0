#event properties (no comments/etc. here are saved)
parent_index = obj_finalTouhouKiller;
sprite_index = spr_dmSwordAndSickle_1;
uses_physics = false;

#event create
event_inherited();
image_speed = 0;
alarm[3] = 15;
alarm[4] = 50;


start = false;
stop = false;
parent = noone;

#event alarm3
start = true;

#event alarm4
instance_create(x,y,obj_tlDMRippleController);

#event step
x = parent.x;
y = parent.y;

if(start && !stop)
{
    image_angle += 30;
}