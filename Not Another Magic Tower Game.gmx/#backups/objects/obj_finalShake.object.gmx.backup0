// 2025-06-19 21:07:08
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
//
timer = 0;

#event destroy
view_xview = 0
view_yview = 0

#event step
view_xview = random_range(-4,4);
view_yview = random_range(-2,2);
timer += 1;
if timer == 10{
    instance_destroy()
}