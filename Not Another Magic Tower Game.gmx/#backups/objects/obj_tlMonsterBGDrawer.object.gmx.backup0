// 2025-06-19 19:04:54
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
centerX = 400;
certerY = 304;
radius = 100;

cx = 400;
cy = 256;

amount = 8;
rspd = 1;
angle = 0;

interval = 50;
acc = 0.05;
time = 0;

#event step
angle -= rspd;
time += 1;
if(time == interval)
{
    time = 0;
}

#event draw
centerX = 400;
certerY = 304;
draw_set_alpha(1);
draw_set_color(c_silver);
draw_set_circle_precision(32);
draw_circle(400,304,radius,true);

for(var i=0;i<360;i+=360/amount)
{
    var tx = cx + lengthdir_x(1000,angle+i);
    var ty = cy + lengthdir_y(1000,angle+i);
    draw_line(cx,cy, tx,ty);
}

for(i=0;i<5;i+=1)
{
    var rc = 64 + 0.5 * acc * sqr(50 - time + interval * i);
    draw_circle(400,304,rc,true);
}

draw_set_color(c_white);
draw_set_circle_precision(24);