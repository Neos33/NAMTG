// 2025-06-19 19:19:04
#event properties (no comments/etc. here are saved)
parent_index = obj_tlKiller;
sprite_index = spr_variationSkeletonCombat;
uses_physics = false;

#event create
image_speed = 1/8;
alarm[4] = 150;

#event alarm3
instance_create(x,y-16,obj_tlVariationDirt);

#event alarm4
sound_fix(sndDevilLaugh1);
alarm[3] = 50;

#event draw
var dHeight = 384 - (y - 16);
if(dHeight > 0)
{
    draw_sprite_part_ext(sprite_index,image_index,0,0,32,dHeight,x - 16,y - 16, 1,1,c_purple,image_alpha);
}
