// 2025-06-19 21:16:15
#event properties (no comments/etc. here are saved)
parent_index = obj_tlPreFinalKillerParent;
sprite_index = spr_darkWarrior_combat;
uses_physics = false;

#event create
event_inherited();
image_speed = 1/8;
count = 0;
spd = 14;
targetX[0] = 672; targetY[0] = 304;
targetX[1] = 400; targetY[1] = 64;
targetX[2] = 128; targetY[2] = 304;
targetX[3] = 400; targetY[3] = 544;

circle = instance_create(x,y,obj_tlMagicCircle);
circle.target = id;

instance_create(x,y,obj_tlSummonEffect);


tIndex = 0;
p = 0;

#event destroy
with(circle)
{
    instance_destroy();
}

#event alarm3
x = -96;
y = -96;

#event alarm4
with(obj_tlDWBomb)
{
    alarm[0] = 1;
}
alarm[5] = 5;

#event alarm5
instance_create(-32,-32,obj_tlDarkWarriorShadow);
instance_destroy();

#event step
if(tIndex <= 3)
{
    if(point_distance(x,y, targetX[tIndex], targetY[tIndex]) < spd)
    {
        speed = 0;
        x = targetX[tIndex];
        y = targetY[tIndex];
        tIndex += 1;
        with(instance_create(x,y,obj_tlDWBomb))
        {
            alarm[0] = 0;
            alarm[1] = 20;
            alarm[11] = 0;
            p = 9;
        }
        for(i=0; i<8;i+=1)
        {
            pp = instance_create(x,y,obj_tlDWBullet)
            pp.direction = i * 45;
        }
        if(count <= 3)
        {
            event_user(0);
        }
    }
    else
    {
        move_towards_point(targetX[tIndex], targetY[tIndex], spd);
    }
}
else
{
    if(!stop)
    {
        alarm[3] = 1;
        alarm[4] = 30;
        with(obj_tlDWBomb)
        {
            alarm[11] = 1;
        }
        stop = true;
    }
}

#event other_outside
//

#event other_user0
with(instance_create(targetX[tIndex], targetY[tIndex], obj_tlDWTarget))
{
    alarm[0] = 0;
}