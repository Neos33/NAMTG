// 2025-06-20 19:30:07
#event properties (no comments/etc. here are saved)
parent_index = -1;
uses_physics = false;

#event create
list = ds_list_create();
ds_list_add(list,1);
ds_list_add(list,2);
ds_list_add(list,3);
ds_list_add(list,4);
ds_list_shuffle(list);
count = 4;
alarm[0] = 1;
ind = 0;

#event alarm0
if(ind < count)
{
    p = ds_list_find_value(list,ind);
    with(obj_tdSpike)
    {
        if(ind == other.p)
        {
            laserStart = instance_create(x+16,y+32,obj_dlLaserStart);
            laserStart.target = instance_position(x,y,object_index);
        }
    }
    ind += 1;
    alarm[0] = 40;
}
else
{
    instance_destroy();
}